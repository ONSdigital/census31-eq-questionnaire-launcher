{
    "name": "census31-eq-questionnaire-launcher",
    "version": "2.0.0",
    "description": "ONS Digital eQ Questionnaire Launcher Dev Tool",
    "author": {
        "name": "ONS Digital",
        "url": "http://onsdigital.github.io/"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ONSdigital/census31-eq-questionnaire-launcher"
    },
    "devDependencies": {
        "standard": "^17.1.2",
        "stylelint": "^17.11.0",
        "stylelint-config-standard": "^40.0.0"
    },
    "prettier": {
        "printWidth": 160,
        "semi": false,
        "overrides": [
            {
                "files": "**/*.js",
                "options": {
                    "singleQuote": true
                }
            }
        ]
    },
    "eslintConfig": {
        "env": {
            "browser": true,
            "es2021": true
        },
        "extends": "eslint:recommended",
        "parserOptions": {
            "ecmaVersion": "latest",
            "sourceType": "module"
        },
        "rules": {
            "no-unused-vars": "off",
            "no-undef": "off"
        }
    },
    "standard": {
        "env": [
            "browser"
        ],
        "globals": [
            "sdsEnabled"
        ]
    }
}
